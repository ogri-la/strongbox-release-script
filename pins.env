# every external input to the release pipelines, pinned by digest or checksum.
# sourced by `lib/common.sh` and passed to image builds as build arguments.
# changing a value here rebuilds the images that use it.

# --- base images (by digest)

# Temurin 17 JDK on Ubuntu 24.04 'noble'.
# Ubuntu 24.04 standard support ends 2029-05. Temurin 17 is supported until at least 2027-10.
# measured 2026-10-03: a jlink'd JRE from this image needs at most GLIBC_2.9.
IMAGE_TEMURIN=eclipse-temurin:17-jdk-noble@sha256:606f2834a35af6180383a6430f0d2c9671d48aca74925061c3e5df2c12e8b0cd
TEMURIN_VERSION=17.0.20.1+1

# Ubuntu 24.04, standard support ends 2029-05.
IMAGE_UBUNTU=ubuntu:24.04@sha256:a853f94d226358a79c740cfc7bce0c289748f3fe3488d921d038ccd752c61b60

# Ubuntu 18.04 (glibc 2.27), out of support. used only as a test target for the JRE start check, never to build.
IMAGE_GLIBC_CEILING=ubuntu:18.04@sha256:152dc042452c496007f07ca9127571cb9c29697f42acbfad72324b2bb2e43c98

# Arch Linux, rolling. generates .SRCINFO and test-builds the AUR package. refresh occasionally.
IMAGE_ARCH=archlinux:base-devel@sha256:51dd3d24f7fba779e7c471caeee7804c50e8c134ad948e19685a1c83a42facc3

# Flathub's linter, the checks Flathub's buildbot runs. rolling 'latest', so refresh deliberately: new rules can fail builds.
# runs as the host user with a writable HOME, and fetches Flathub's per-app exceptions over the network.
IMAGE_FLATPAK_LINT=ghcr.io/flathub-infra/flatpak-builder-lint:latest@sha256:8ed347aa44505db9f786a797ab78239bdd7c92027bd7a6817af51add26a20b83

# --- tools (by version and sha256)

GH_VERSION=2.102.0
GH_SHA256=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386

# statically linked (musl) build.
PARSE_CHANGELOG_VERSION=0.6.17
PARSE_CHANGELOG_SHA256=d78fe1527b14d55328e3e8e130123cdbb3606d4055ca207f7e03ae51fc3c7e03

# 2.13.0 is not used: its `bin/lein` was never released and still reads '2.12.1-SNAPSHOT'.
LEIN_VERSION=2.12.0
LEIN_SCRIPT_SHA256=f8e1266c0c78c08bd4af6e111889ecc316c9dd56d1e8645bbee6c1703d351bc3
LEIN_JAR_SHA256=b721a573af631784f27ccb52e719e6d1287d9d3951ad56d316d38f7ecfa81aa2

# replaces the deprecated AppImageKit release 13. this asset reports "continuous build 296, built 2025-12-04",
# later than the 1.9.1 release date, so upstream re-uploaded it once. the checksum pins this upload.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0

# static runtime embedded in the AppImage. appimagetool downloads an unpinned runtime unless given one.
APPIMAGE_RUNTIME_VERSION=20251108
APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d

# --- policy

# highest GLIBC_ symbol version any shared object in the AppImage may require.
GLIBC_CEILING=2.27
